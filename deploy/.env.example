# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Hostname the stack answers on. Caddy requests a certificate for exactly this
# name, so an A record for it must already point at this machine before the
# first `docker compose up` — see README.md. Also used as coturn's realm and as
# the host part of the turn: URLs the signal server advertises.
TETHER_DOMAIN=tether.example.com

# Shared admission secret for the signal server. Every host and controller
# presents it to register. It gates the directory, not the media: pairing is
# what authorizes a device against a host. Generate with `openssl rand -hex 32`.
TETHER_SECRET=

# coturn's shared HMAC secret, from which the signal server mints short-lived
# relay credentials. This must equal static-auth-secret in turnserver.conf, or
# relayed sessions fail while everything else looks fine. Generate separately
# from TETHER_SECRET — they protect different things.
TETHER_TURN_SECRET=

# The public IPv4 address of this machine, which coturn advertises in relay
# candidates. On a plain VPS it is the address the A record points at; behind
# NAT it is the outside address, not the interface address.
TETHER_EXTERNAL_IP=203.0.113.10
