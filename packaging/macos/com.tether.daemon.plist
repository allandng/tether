<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent for the Tether host. No arguments: tetherd reads the
  signal server, secret and everything else from ~/.config/tether/config.toml
  (written by `tetherd setup`, mode 0600), so the secret never appears in
  `ps`. LaunchAgent, not LaunchDaemon: capture and input need the logged-in
  GUI session and its TCC grants.
  This is a template: launchd does not expand ~, so postinstall replaces
  __HOME__ with the user's home when it writes their copy. Logs go to
  ~/Library/Logs/Tether/tetherd.log (per user, not shared /tmp).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tether.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/tetherd</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NO_COLOR</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/Tether/tetherd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Tether/tetherd.log</string>
</dict>
</plist>
